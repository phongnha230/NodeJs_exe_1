// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Phân quyền thành viên nhóm
enum Role {
  OWNER
  ADMIN
  MEMBER
}

// 2. Trạng thái công việc
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// 3. Mức độ ưu tiên
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Model 1: Người dùng hệ thống (Đồng bộ với Supabase Auth)
model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  password      String?      // Optional nếu đăng ký qua Supabase Auth
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Quan hệ
  ownedTeams    Team[]         @relation("TeamOwner")
  memberships   TeamMember[]
  assignedTasks Task[]         @relation("AssignedTasks")
  createdTasks  Task[]         @relation("CreatedTasks")
  chatMessages  ChatMessage[]
  notifications Notification[]

  @@map("users")
}

// Model 2: Nhóm làm việc
model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Quan hệ
  owner        User          @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  tasks        Task[]
  chatMessages ChatMessage[]

  @@map("teams")
}

// Model 3: Bảng quan hệ N-N giữa Team và User
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  // Quan hệ
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// Model 4: Quản lý công việc
model Task {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    TaskPriority  @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Quan hệ Team
  teamId      String?
  team        Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Người được phân công
  assigneeId  String?
  assignee    User?         @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Người tạo công việc (Dùng cho quyền xóa task theo Assignment 2)
  creatorId   String?
  creator     User?         @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// Model 5: Tin nhắn trong phòng chat của nhóm (Assignment 3 & 4)
model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  teamId    String
  senderId  String
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@map("chat_messages")
}

// Model 6: Thông báo trong hệ thống (Assignment 3 & 4)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  type      String   // "TASK_ASSIGNED" | "ADDED_TO_TEAM"
  link      String?  // Đường dẫn đến trang team/task liên quan
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
